# Copy to .env and fill in:  cp .env.example .env
# Only GEMINI_API_KEY is required; everything else has a sensible default.

# Get a key at https://aistudio.google.com/apikey (used by the backend only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Changing this after uploading documents means re-uploading them.
EMBEDDING_DIMENSIONS=768

# Where the SQLite database is stored.
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Retrieval tuning. Sizes are in characters.
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
TOP_K=5
# 0-1. Lower it if answers too often say nothing was found.
MIN_SIMILARITY=0.6

# Web origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000
